[
  {
    "name": "theme_info",
    "theme_name": "ConversionMax Pro",
    "theme_version": "1.0.0",
    "theme_author": "ConversionMax",
    "theme_documentation_url": "https://docs.conversionmaxpro.com",
    "theme_support_url": "https://support.conversionmaxpro.com"
  },
  {
    "name": "Branding & Navigation",
    "settings": [
      {
        "type": "header",
        "content": "Header"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 80,
        "max": 280,
        "step": 10,
        "default": 160
      },
      {
        "type": "link_list",
        "id": "main_menu",
        "label": "Main menu",
        "default": "main-menu"
      },
      {
        "type": "checkbox",
        "id": "enable_header_search",
        "label": "Enable header search",
        "default": true
      },
      {
        "type": "header",
        "content": "Footer"
      },
      {
        "type": "link_list",
        "id": "footer_menu",
        "label": "Footer menu",
        "default": "footer"
      },
      {
        "type": "link_list",
        "id": "legal_menu",
        "label": "Legal menu"
      }
    ]
  },
  {
    "name": "Exit Intent Popup",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_exit_popup",
        "label": "Enable exit-intent popup",
        "default": false
      },
      {
        "type": "text",
        "id": "exit_popup_headline",
        "label": "Headline",
        "default": "Wait! Here is 10% off before you go"
      },
      {
        "type": "text",
        "id": "exit_popup_body",
        "label": "Body text",
        "default": "Use this one-time code in the next few minutes to unlock your discount."
      },
      {
        "type": "text",
        "id": "exit_popup_code",
        "label": "Discount code",
        "default": "SAVE10"
      },
      {
        "type": "range",
        "id": "exit_popup_minutes",
        "label": "Timer length (minutes)",
        "min": 5,
        "max": 60,
        "step": 5,
        "default": 10
      },
      {
        "type": "text",
        "id": "exit_popup_button_text",
        "label": "Button text",
        "default": "Claim Discount"
      },
      {
        "type": "url",
        "id": "exit_popup_button_link",
        "label": "Button link"
      }
    ]
  },
  {
    "name": "License",
    "settings": [
      {
        "type": "header",
        "content": "License Activation"
      },
      {
        "type": "paragraph",
        "content": "Enter your Lemon Squeezy license key to activate ConversionMax Pro. Your storefront works without activation, but please support the theme by activating your license."
      },
      {
        "type": "text",
        "id": "license_key",
        "label": "License Key",
        "info": "Your Lemon Squeezy license key (e.g., XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX)"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Primary Colors"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary",
        "default": "#1B7FC3",
        "info": "Main CTA and accent color"
      },
      {
        "type": "color",
        "id": "color_primary_hover",
        "label": "Primary Hover",
        "default": "#155B8A"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary",
        "default": "#1D3557"
      },
      {
        "type": "header",
        "content": "Background & Text"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Page Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_bg_alt",
        "label": "Alternate Section Background",
        "default": "#F8F9FA"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Body Text",
        "default": "#212529"
      },
      {
        "type": "color",
        "id": "color_text_light",
        "label": "Light Text",
        "default": "#6C757D"
      },
      {
        "type": "color",
        "id": "color_heading",
        "label": "Headings",
        "default": "#1D3557"
      },
      {
        "type": "header",
        "content": "Utility Colors"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Success / Guarantee",
        "default": "#2D6A4F"
      },
      {
        "type": "color",
        "id": "color_warning",
        "label": "Warning / Urgency",
        "default": "#E76F51"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders",
        "default": "#DEE2E6"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "label": "Base Font Size (px)",
        "min": 14,
        "max": 20,
        "step": 1,
        "default": 16
      }
    ]
  },
  {
    "name": "Tracking Pixels",
    "settings": [
      {
        "type": "header",
        "content": "Meta (Facebook) Pixel"
      },
      {
        "type": "text",
        "id": "meta_pixel_id",
        "label": "Meta Pixel ID",
        "info": "Enter your Meta (Facebook) Pixel ID. Leave blank to disable."
      },
      {
        "type": "header",
        "content": "TikTok Pixel"
      },
      {
        "type": "text",
        "id": "tiktok_pixel_id",
        "label": "TikTok Pixel ID",
        "info": "Enter your TikTok Pixel ID. Leave blank to disable."
      },
      {
        "type": "header",
        "content": "Google Tag Manager"
      },
      {
        "type": "text",
        "id": "gtm_container_id",
        "label": "GTM Container ID",
        "info": "Enter your GTM Container ID (e.g., GTM-XXXXXX). Leave blank to disable."
      },
      {
        "type": "header",
        "content": "Snapchat Pixel"
      },
      {
        "type": "text",
        "id": "snapchat_pixel_id",
        "label": "Snapchat Pixel ID",
        "info": "Enter your Snapchat Pixel ID. Leave blank to disable."
      }
    ]
  },
  {
    "name": "AI Copywriter",
    "settings": [
      {
        "type": "header",
        "content": "AI-Powered Copy Generation"
      },
      {
        "type": "paragraph",
        "content": "ConversionMax Pro can generate high-converting VSL scripts, headlines, FAQs, and guarantee copy using AI. Bring your own API key from any supported provider. Your key stays in your theme settings and is never shared."
      },
      {
        "type": "select",
        "id": "ai_provider",
        "label": "AI Provider",
        "options": [
          { "value": "openai", "label": "OpenAI (GPT-4o)" },
          { "value": "anthropic", "label": "Anthropic (Claude)" },
          { "value": "gemini", "label": "Google Gemini" }
        ],
        "default": "openai",
        "info": "Choose your preferred AI provider."
      },
      {
        "type": "text",
        "id": "ai_api_key",
        "label": "API Key",
        "info": "Your API key for the selected provider. This is stored securely in your theme settings and only used in the theme editor."
      },
      {
        "type": "select",
        "id": "ai_tone",
        "label": "Default copy tone",
        "options": [
          { "value": "urgent", "label": "Urgent & Persuasive" },
          { "value": "friendly", "label": "Friendly & Approachable" },
          { "value": "professional", "label": "Professional & Authoritative" },
          { "value": "casual", "label": "Casual & Conversational" },
          { "value": "luxury", "label": "Premium & Luxury" }
        ],
        "default": "urgent",
        "info": "Sets the default voice for all AI-generated copy."
      },
      {
        "type": "header",
        "content": "Product Context"
      },
      {
        "type": "paragraph",
        "content": "Fill in these fields so the AI understands your product. This context is sent with every generation request to produce relevant, on-brand copy."
      },
      {
        "type": "text",
        "id": "ai_product_name",
        "label": "Product / Brand name",
        "info": "e.g., GlowMax Skincare Serum"
      },
      {
        "type": "textarea",
        "id": "ai_product_description",
        "label": "What does your product do?",
        "info": "Describe the product, what it does, and why it's special. 2-3 sentences."
      },
      {
        "type": "text",
        "id": "ai_target_audience",
        "label": "Target audience",
        "info": "e.g., Women 25-45 who struggle with acne and want clear skin"
      },
      {
        "type": "text",
        "id": "ai_pain_points",
        "label": "Customer pain points",
        "info": "Comma-separated. e.g., acne scars, dull skin, expensive treatments that don't work"
      },
      {
        "type": "text",
        "id": "ai_key_benefits",
        "label": "Key benefits / results",
        "info": "Comma-separated. e.g., clear skin in 30 days, all-natural ingredients, dermatologist approved"
      },
      {
        "type": "text",
        "id": "ai_social_proof",
        "label": "Social proof / stats",
        "info": "e.g., 10,000+ happy customers, 4.9 star rating, featured in Vogue"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "max_page_width",
        "label": "Max Page Width (px)",
        "min": 1000,
        "max": 1600,
        "step": 40,
        "default": 1200
      },
      {
        "type": "range",
        "id": "section_spacing",
        "label": "Section Spacing (px)",
        "min": 20,
        "max": 100,
        "step": 4,
        "default": 60
      }
    ]
  }
]

