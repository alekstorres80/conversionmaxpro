  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "open_sans_n7",
        "info": "Bold, condensed sans-serif works best."
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "helvetica_n4"
      },
      {
        "type": "font_picker",
        "id": "font_accent",
        "label": "Accent Font (nav, buttons)",
        "default": "montserrat_n6"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "label": "Base Font Size (px)",
        "min": 14,
        "max": 20,
        "step": 1,
        "default": 15
      },
      {
        "type": "checkbox",
        "id": "uppercase_headings",
        "label": "Uppercase Headings",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "uppercase_nav",
        "label": "Uppercase Navigation",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "uppercase_buttons",
        "label": "Uppercase Buttons",
        "default": true
      }
    ]
  },
  {
    "name": "Header & Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo_image",
        "label": "Logo image",
        "info": "Upload your logo. Leave blank to display shop name as text."
      },
      {
        "type": "range",
        "id": "logo_max_width",
        "label": "Logo max width (px)",
        "min": 80,
        "max": 400,
        "step": 10,
        "default": 200
      },
      {
        "type": "checkbox",
        "id": "logo_hide_mobile",
        "label": "Hide logo on mobile",
        "default": false
      },
      {
        "type": "text",
        "id": "header_message",
        "label": "Header announcement",
        "info": "Optional small text shown in header (e.g. 'Free shipping over $50').",
        "default": "Free shipping on orders over $50"
      },
      {
        "type": "checkbox",
        "id": "header_show_account",
        "label": "Show account link",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_show_cart_badge",
        "label": "Show cart count badge",
        "default": true
      }
    ]
  },
  {
    "name": "Navigation",
    "settings": [
      {
        "type": "link_list",
        "id": "main_menu_linklist",
        "label": "Main menu",
        "default": "main-menu"
      }
    ]
  },
