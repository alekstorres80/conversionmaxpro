[
  {
    "name": "theme_info",
    "theme_name": "ConversionMax Pro",
    "theme_version": "1.1.0",
    "theme_author": "ConversionMax",
    "theme_documentation_url": "https://docs.conversionmaxpro.com",
    "theme_support_url": "https://support.conversionmaxpro.com"
