        "max": 1600,
        "step": 40,
        "default": 1200
      },
      {
        "type": "range",
        "id": "section_spacing",
        "label": "Section Spacing (px)",
        "min": 20,
        "max": 100,
        "step": 4,
        "default": 60
      }
    ]
