<div class="cmp-section">
  <div class="cmp-container" style="max-width: 440px;">
    <h1 style="text-align: center;">Login</h1>

    {%- form 'customer_login' -%}
      {{ form.errors | default_errors }}

      <div style="margin-top: 24px;">
        <label for="CustomerEmail" style="font-weight: 600; display: block; margin-bottom: 4px;">Email</label>
        <input
          type="email"
          id="CustomerEmail"
          name="customer[email]"
          autocomplete="email"
          style="width: 100%; padding: 12px; border: 1px solid var(--color-border); border-radius: 6px; font-size: 1rem;"
        >
      </div>

      <div style="margin-top: 16px;">
        <label for="CustomerPassword" style="font-weight: 600; display: block; margin-bottom: 4px;">Password</label>
        <input
          type="password"
          id="CustomerPassword"
          name="customer[password]"
          autocomplete="current-password"
          style="width: 100%; padding: 12px; border: 1px solid var(--color-border); border-radius: 6px; font-size: 1rem;"
        >
      </div>

      <div style="margin-top: 24px;">
        <button type="submit" class="cmp-btn cmp-btn--primary" style="width: 100%;">Sign In</button>
      </div>

      <p style="text-align: center; margin-top: 16px; font-size: 0.9rem;">
        <a href="/account/register">Create account</a> &middot;
        <a href="#recover">Forgot password?</a>
      </p>
    {%- endform -%}
  </div>
</div>
