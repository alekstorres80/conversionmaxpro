<div class="cmp-section">
  <div class="cmp-container" style="max-width: 440px;">
    <h1 style="text-align: center;">Create Account</h1>

    {%- form 'create_customer' -%}
      {{ form.errors | default_errors }}

      <div style="margin-top: 24px;">
        <label for="FirstName" style="font-weight: 600; display: block; margin-bottom: 4px;">First Name</label>
        <input type="text" id="FirstName" name="customer[first_name]" style="width: 100%; padding: 12px; border: 1px solid var(--color-border); border-radius: 6px; font-size: 1rem;">
      </div>

      <div style="margin-top: 16px;">
        <label for="LastName" style="font-weight: 600; display: block; margin-bottom: 4px;">Last Name</label>
        <input type="text" id="LastName" name="customer[last_name]" style="width: 100%; padding: 12px; border: 1px solid var(--color-border); border-radius: 6px; font-size: 1rem;">
      </div>

      <div style="margin-top: 16px;">
        <label for="Email" style="font-weight: 600; display: block; margin-bottom: 4px;">Email</label>
        <input type="email" id="Email" name="customer[email]" autocomplete="email" style="width: 100%; padding: 12px; border: 1px solid var(--color-border); border-radius: 6px; font-size: 1rem;">
      </div>

      <div style="margin-top: 16px;">
        <label for="Password" style="font-weight: 600; display: block; margin-bottom: 4px;">Password</label>
        <input type="password" id="Password" name="customer[password]" autocomplete="new-password" style="width: 100%; padding: 12px; border: 1px solid var(--color-border); border-radius: 6px; font-size: 1rem;">
      </div>

      <div style="margin-top: 24px;">
        <button type="submit" class="cmp-btn cmp-btn--primary" style="width: 100%;">Create Account</button>
      </div>

      <p style="text-align: center; margin-top: 16px; font-size: 0.9rem;">
        Already have an account? <a href="/account/login">Sign in</a>
      </p>
    {%- endform -%}
  </div>
</div>
