<div class="cmp-section">
  <div class="cmp-container" style="max-width: 440px; text-align: center;">
    <h1>{{ shop.name }}</h1>
    <p style="color: var(--color-text-light); margin: 8px 0 32px;">This store is coming soon. Enter the password to access:</p>

    {%- form 'storefront_password' -%}
      {{ form.errors | default_errors }}
      <div style="display: flex; gap: 12px;">
        <input
          type="password"
          name="password"
          placeholder="Password"
          style="flex: 1; padding: 12px; border: 1px solid var(--color-border); border-radius: 6px; font-size: 1rem;"
        >
        <button type="submit" class="cmp-btn cmp-btn--primary">Enter</button>
      </div>
    {%- endform -%}
  </div>
</div>
