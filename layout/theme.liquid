<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    {%- if page_title -%}
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    {%- else -%}
      {{ shop.name }}
    {%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {%- comment -%} Font face declarations {%- endcomment -%}
  <style>
    {{ settings.font_heading | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_face: font_display: 'swap' }}
  </style>

  {%- comment -%} CSS Custom Properties from theme settings {%- endcomment -%}
  <style>
    :root {
      --color-primary: {{ settings.color_primary }};
      --color-primary-hover: {{ settings.color_primary_hover }};
      --color-secondary: {{ settings.color_secondary }};
      --color-bg: {{ settings.color_bg }};
      --color-bg-alt: {{ settings.color_bg_alt }};
      --color-text: {{ settings.color_text }};
      --color-text-light: {{ settings.color_text_light }};
      --color-heading: {{ settings.color_heading }};
      --color-success: {{ settings.color_success }};
      --color-warning: {{ settings.color_warning }};
      --color-border: {{ settings.color_border }};
      --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
      --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      --font-size-base: {{ settings.font_size_base }}px;
      --max-page-width: {{ settings.max_page_width }}px;
      --section-spacing: {{ settings.section_spacing }}px;
    }
  </style>

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}

  {%- comment -%} Pixel scripts — storefront only, not in theme editor {%- endcomment -%}
  {% render 'pixel-scripts' %}

  {%- comment -%} GTM noscript handled after body tag {%- endcomment -%}
</head>

<body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix | handle }}{% endif %}">

  {%- if settings.gtm_container_id != blank -%}
    {% unless request.design_mode %}
      <!-- Google Tag Manager (noscript) -->
      <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id={{ settings.gtm_container_id | escape }}"
          height="0" width="0" style="display:none;visibility:hidden"></iframe>
      </noscript>
    {% endunless %}
  {%- endif -%}

  <a href="#main-content" class="skip-link visually-hidden">Skip to content</a>

  {%- comment -%} License banner — admin only {%- endcomment -%}
  {% render 'license-banner' %}

  <header class="cmp-header" role="banner">
    <div class="cmp-container cmp-header__inner">
      <a href="{{ routes.root_url }}" class="cmp-header__brand" aria-label="{{ shop.name }}">
        {% if settings.logo != blank %}
          <img
            src="{{ settings.logo | image_url: width: 280 }}"
            alt="{{ settings.logo.alt | default: shop.name | escape }}"
            width="{{ settings.logo_width | default: 160 }}"
            loading="eager"
          >
        {% else %}
          <span class="cmp-header__brand-text">{{ shop.name }}</span>
        {% endif %}
      </a>

      <nav class="cmp-header__nav" aria-label="Primary">
        {% if settings.main_menu != blank %}
          <ul class="cmp-header__menu">
            {% for link in linklists[settings.main_menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </nav>

      <div class="cmp-header__tools">
        {% if settings.enable_header_search %}
          <form class="cmp-header__search" action="{{ routes.search_url }}" method="get" role="search">
            <input
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="Search products"
              aria-label="Search products"
            >
            <button type="submit" aria-label="Search">Search</button>
          </form>
        {% endif %}

        <div class="cmp-header__actions" aria-label="Account and cart">
          {% if shop.customer_accounts_enabled %}
            <a class="cmp-header__icon-link" href="{{ routes.account_url }}" aria-label="Account">
              <span class="cmp-header__icon" aria-hidden="true">&#128100;</span>
            </a>
          {% endif %}

          <a class="cmp-header__icon-link cmp-header__icon-link--cart" href="{{ routes.cart_url }}" aria-label="Cart">
            <span class="cmp-header__icon" aria-hidden="true">&#128722;</span>
            {% if cart.item_count > 0 %}
              <span class="cmp-header__cart-count">{{ cart.item_count }}</span>
            {% endif %}
          </a>
        </div>

        <button class="cmp-header__menu-toggle" type="button" data-cmp-menu-toggle aria-expanded="false" aria-controls="cmp-mobile-menu">
          Menu
        </button>
      </div>
    </div>

    <div id="cmp-mobile-menu" class="cmp-header__mobile" data-cmp-mobile-menu hidden>
      <div class="cmp-container">
        {% if settings.main_menu != blank %}
          <ul class="cmp-header__mobile-menu">
            {% for link in linklists[settings.main_menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}

        <div class="cmp-header__mobile-actions" aria-label="Mobile account and cart">
          {% if shop.customer_accounts_enabled %}
            <a class="cmp-header__icon-link" href="{{ routes.account_url }}">Account</a>
          {% endif %}
          <a class="cmp-header__icon-link" href="{{ routes.cart_url }}">Cart{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>
        </div>

        {% if settings.enable_header_search %}
          <form class="cmp-header__search cmp-header__search--mobile" action="{{ routes.search_url }}" method="get" role="search">
            <input
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="Search products"
              aria-label="Search products"
            >
            <button type="submit" aria-label="Search">Search</button>
          </form>
        {% endif %}
      </div>
    </div>
  </header>

  <main id="main-content" role="main">
    {{ content_for_layout }}
  </main>

  <footer class="cmp-footer" role="contentinfo">
    <div class="cmp-container cmp-footer__inner">
      <div class="cmp-footer__brand">
        {% if settings.logo != blank %}
          <img
            src="{{ settings.logo | image_url: width: 220 }}"
            alt="{{ settings.logo.alt | default: shop.name | escape }}"
            width="120"
            loading="lazy"
          >
        {% else %}
          <span>{{ shop.name }}</span>
        {% endif %}
      </div>

      {% if settings.footer_menu != blank %}
        <nav class="cmp-footer__nav" aria-label="Footer">
          <ul>
            {% for link in linklists[settings.footer_menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}

      {% if settings.legal_menu != blank %}
        <nav class="cmp-footer__legal" aria-label="Legal">
          <ul>
            {% for link in linklists[settings.legal_menu].links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}

      <p class="cmp-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    </div>
  </footer>

  {% if settings.enable_exit_popup and request.design_mode == false %}
    <div class="cmp-exit-popup" data-exit-popup hidden>
      <div class="cmp-exit-popup__backdrop" data-exit-close></div>
      <div class="cmp-exit-popup__card" role="dialog" aria-modal="true" aria-label="Special offer">
        <button class="cmp-exit-popup__close" type="button" data-exit-close aria-label="Close">x</button>
        <p class="cmp-exit-popup__eyebrow">Limited-time offer</p>
        <h3 class="cmp-exit-popup__title">{{ settings.exit_popup_headline | escape }}</h3>
        <p class="cmp-exit-popup__body">{{ settings.exit_popup_body | escape }}</p>

        <div class="cmp-exit-popup__timer">
          Offer expires in <strong data-exit-timer>10:00</strong>
        </div>

        <div class="cmp-exit-popup__code-row">
          <span class="cmp-exit-popup__code" data-exit-code>{{ settings.exit_popup_code | escape }}</span>
          <button class="cmp-exit-popup__copy" type="button" data-exit-copy>Copy</button>
        </div>

        {% if settings.exit_popup_button_text != blank %}
          <a href="{{ settings.exit_popup_button_link | default: routes.cart_url }}" class="cmp-btn cmp-btn--primary cmp-btn--full">
            {{ settings.exit_popup_button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  {% endif %}
  <a class="cmp-mobile-sticky-cart" href="{{ routes.cart_url }}" aria-label="View cart">
    <span class="cmp-mobile-sticky-cart__icon" aria-hidden="true">&#128722;</span>
    <span>Cart</span>
    {% if cart.item_count > 0 %}<span class="cmp-mobile-sticky-cart__count">{{ cart.item_count }}</span>{% endif %}
  </a>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  <script>
    (function () {
      var toggle = document.querySelector('[data-cmp-menu-toggle]');
      var panel = document.querySelector('[data-cmp-mobile-menu]');
      if (!toggle || !panel) return;

      toggle.addEventListener('click', function () {
        var isOpen = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        panel.hidden = isOpen;
      });
    })();
  </script>
  {% if settings.enable_exit_popup and request.design_mode == false %}
  <script>
    (function () {
      var popup = document.querySelector('[data-exit-popup]');
      if (!popup) return;

      var timerEl = popup.querySelector('[data-exit-timer]');
      var copyBtn = popup.querySelector('[data-exit-copy]');
      var codeEl = popup.querySelector('[data-exit-code]');
      var closeEls = popup.querySelectorAll('[data-exit-close]');
      var key = 'cmp_exit_popup_seen';
      var timerKey = 'cmp_exit_popup_timer_end';
      var minutes = {{ settings.exit_popup_minutes | default: 10 }};
      var shown = false;

      function closePopup() {
        popup.hidden = true;
        try { sessionStorage.setItem(key, '1'); } catch (e) {}
      }

      function openPopup() {
        if (shown) return;
        shown = true;
        popup.hidden = false;
        startTimer();
      }

      function startTimer() {
        var end;
        try {
          var stored = localStorage.getItem(timerKey);
          if (stored) end = parseInt(stored, 10);
        } catch (e) {}

        if (!end || end <= Date.now()) {
          end = Date.now() + (minutes * 60 * 1000);
          try { localStorage.setItem(timerKey, String(end)); } catch (e) {}
        }

        function tick() {
          var diff = Math.max(0, end - Date.now());
          var total = Math.floor(diff / 1000);
          var m = Math.floor(total / 60);
          var s = total % 60;
          timerEl.textContent = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
          if (diff > 0 && !popup.hidden) setTimeout(tick, 1000);
        }

        tick();
      }

      function onExitIntent(e) {
        if (e.clientY > 10) return;
        try { if (sessionStorage.getItem(key) === '1') return; } catch (err) {}
        openPopup();
        document.removeEventListener('mouseout', onExitIntent);
      }

      closeEls.forEach(function (el) { el.addEventListener('click', closePopup); });

      if (copyBtn && codeEl && navigator.clipboard) {
        copyBtn.addEventListener('click', function () {
          navigator.clipboard.writeText(codeEl.textContent.trim()).then(function () {
            copyBtn.textContent = 'Copied';
            setTimeout(function () { copyBtn.textContent = 'Copy'; }, 1200);
          });
        });
      }

      document.addEventListener('mouseout', onExitIntent);
    })();
  </script>
  {% endif %}

  {%- comment -%} AI Copywriter — only loaded inside the theme editor {%- endcomment -%}
  {%- if request.design_mode -%}
    {{ 'ai-copywriter.css' | asset_url | stylesheet_tag }}
    <script
      src="{{ 'ai-copywriter.js' | asset_url }}"
      data-ai-copywriter
      data-provider="{{ settings.ai_provider }}"
      data-api-key="{{ settings.ai_api_key }}"
      data-tone="{{ settings.ai_tone }}"
      data-product-name="{{ settings.ai_product_name | escape }}"
      data-product-desc="{{ settings.ai_product_description | escape }}"
      data-audience="{{ settings.ai_target_audience | escape }}"
      data-pain-points="{{ settings.ai_pain_points | escape }}"
      data-benefits="{{ settings.ai_key_benefits | escape }}"
      data-social-proof="{{ settings.ai_social_proof | escape }}"
    ></script>
  {%- endif -%}

  {%- comment -%}
    Section-specific JS — loaded only when the section is on the page.
    Each section template includes its own script tag referencing its asset.
  {%- endcomment -%}
</body>
</html>

