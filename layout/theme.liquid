<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>
    {%- if page_title -%}
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    {%- else -%}
      {{ shop.name }}
    {%- endif -%}
  </title>

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  {%- comment -%} Font face declarations {%- endcomment -%}
  <style>
    {{ settings.font_heading | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_face: font_display: 'swap' }}
  </style>

  {%- comment -%} CSS Custom Properties from theme settings {%- endcomment -%}
  <style>
    :root {
      --color-primary: {{ settings.color_primary }};
      --color-primary-hover: {{ settings.color_primary_hover }};
      --color-secondary: {{ settings.color_secondary }};
      --color-bg: {{ settings.color_bg }};
      --color-bg-alt: {{ settings.color_bg_alt }};
      --color-text: {{ settings.color_text }};
      --color-text-light: {{ settings.color_text_light }};
      --color-heading: {{ settings.color_heading }};
      --color-success: {{ settings.color_success }};
      --color-warning: {{ settings.color_warning }};
      --color-border: {{ settings.color_border }};
      --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
      --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
      --font-size-base: {{ settings.font_size_base }}px;
      --max-page-width: {{ settings.max_page_width }}px;
      --section-spacing: {{ settings.section_spacing }}px;
    }
  </style>

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}

  {%- comment -%} Pixel scripts — storefront only, not in theme editor {%- endcomment -%}
  {% render 'pixel-scripts' %}

  {%- comment -%} GTM noscript handled after body tag {%- endcomment -%}
</head>

<body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix | handle }}{% endif %}">

  {%- if settings.gtm_container_id != blank -%}
    {% unless request.design_mode %}
      <!-- Google Tag Manager (noscript) -->
      <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id={{ settings.gtm_container_id | escape }}"
          height="0" width="0" style="display:none;visibility:hidden"></iframe>
      </noscript>
    {% endunless %}
  {%- endif -%}

  <a href="#main-content" class="skip-link visually-hidden">Skip to content</a>

  {%- comment -%} License banner — admin only {%- endcomment -%}
  {% render 'license-banner' %}

  <main id="main-content" role="main">
    {{ content_for_layout }}
  </main>

  {%- comment -%} Minimal footer {%- endcomment -%}
  <footer class="cmp-footer" role="contentinfo">
    <div class="cmp-container">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    </div>
  </footer>

  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  {%- comment -%} AI Copywriter — only loaded inside the theme editor {%- endcomment -%}
  {%- if request.design_mode -%}
    {{ 'ai-copywriter.css' | asset_url | stylesheet_tag }}
    <script
      src="{{ 'ai-copywriter.js' | asset_url }}"
      data-ai-copywriter
      data-provider="{{ settings.ai_provider }}"
      data-api-key="{{ settings.ai_api_key }}"
      data-tone="{{ settings.ai_tone }}"
      data-product-name="{{ settings.ai_product_name | escape }}"
      data-product-desc="{{ settings.ai_product_description | escape }}"
      data-audience="{{ settings.ai_target_audience | escape }}"
      data-pain-points="{{ settings.ai_pain_points | escape }}"
      data-benefits="{{ settings.ai_key_benefits | escape }}"
      data-social-proof="{{ settings.ai_social_proof | escape }}"
    ></script>
  {%- endif -%}

  {%- comment -%}
    Section-specific JS — loaded only when the section is on the page.
    Each section template includes its own script tag referencing its asset.
  {%- endcomment -%}
</body>
</html>
