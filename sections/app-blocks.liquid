{%- comment -%}
  Generic App Blocks Section
  Use this for review widgets, frequently-bought-together widgets, etc.
{%- endcomment -%}

<section class="cmp-app-blocks cmp-section">
  <div class="cmp-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="cmp-app-blocks__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if request.design_mode -%}
      <div class="cmp-app-blocks__helper">
        Add your app widget here: click <strong>Add block</strong> in this section, then choose your Reviews or Frequently Bought Together app block.
      </div>
    {%- endif -%}

    <div class="cmp-app-blocks__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .cmp-app-blocks__helper {
    margin: 10px 0 14px;
    padding: 10px 12px;
    border: 1px dashed #c7d2fe;
    border-radius: 8px;
    background: #f8faff;
    color: #334155;
    font-size: 0.92rem;
    line-height: 1.4;
  }
</style>

{% schema %}
{
  "name": "Legacy App Blocks (Delete)",
  "tag": "section",
  "class": "cmp-section-app-blocks",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Legacy App Blocks (Delete)"
    }
  ]
}
{% endschema %}

