<section class="cmp-countdown cmp-section"
  style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding: 40px 20px; text-align: center;"
>
  <div class="cmp-container">
    <h2 style="color: {{ section.settings.text_color }}; margin-bottom: 20px;">{{ section.settings.heading }}</h2>

    <div style="display: flex; justify-content: center; gap: 20px;">
      <div>
        <span style="font-size: 2rem; font-weight: bold;">00</span>
        <br>
        <span>Days</span>
      </div>
      <span style="font-size: 2rem;">:</span>
      <div>
        <span style="font-size: 2rem; font-weight: bold;">00</span>
        <br>
        <span>Hours</span>
      </div>
      <span style="font-size: 2rem;">:</span>
      <div>
        <span style="font-size: 2rem; font-weight: bold;">00</span>
        <br>
        <span>Minutes</span>
      </div>
      <span style="font-size: 2rem;">:</span>
      <div>
        <span style="font-size: 2rem; font-weight: bold;">00</span>
        <br>
        <span>Seconds</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Countdown Timer",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This Special Offer Expires In..."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1D3557"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Countdown Timer"
    }
  ]
}
{% endschema %}
