<div
  class="cmp-countdown cmp-section"
  id="countdown-{{ section.id }}"
  data-countdown-section
  data-countdown-mode="{{ section.settings.mode }}"
  data-countdown-end="{{ section.settings.end_date }}T{{ section.settings.end_time }}:00"
  data-countdown-duration="{{ section.settings.evergreen_minutes | default: 30 }}"
  data-countdown-storage-key="cmp_countdown_{{ section.id }}"
  style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding: 40px 20px; text-align: center;"
>
  <div class="cmp-container">
    {% if section.settings.heading != blank %}
      <h2 style="color: {{ section.settings.text_color }}; margin-bottom: 20px;">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="cmp-countdown__timer" data-countdown-timer style="display: flex; justify-content: center; gap: 20px;">
      <div class="cmp-countdown__unit">
        <span class="cmp-countdown__number cmp-countdown__days" data-countdown-days style="font-size: 2rem; font-weight: bold;">00</span>
        <br>
        <span class="cmp-countdown__label">Days</span>
      </div>
      <span style="font-size: 2rem;">:</span>
      <div class="cmp-countdown__unit">
        <span class="cmp-countdown__number cmp-countdown__hours" data-countdown-hours style="font-size: 2rem; font-weight: bold;">00</span>
        <br>
        <span class="cmp-countdown__label">Hours</span>
      </div>
      <span style="font-size: 2rem;">:</span>
      <div class="cmp-countdown__unit">
        <span class="cmp-countdown__number cmp-countdown__mins" data-countdown-mins style="font-size: 2rem; font-weight: bold;">00</span>
        <br>
        <span class="cmp-countdown__label">Minutes</span>
      </div>
      <span style="font-size: 2rem;">:</span>
      <div class="cmp-countdown__unit">
        <span class="cmp-countdown__number cmp-countdown__secs" data-countdown-secs style="font-size: 2rem; font-weight: bold;">00</span>
        <br>
        <span class="cmp-countdown__label">Seconds</span>
      </div>
    </div>

    <div class="cmp-countdown__expired" data-countdown-expired style="display: none;">
      {{ section.settings.expired_message }}
    </div>
  </div>
</div>

<script>
  (function () {
    var sectionId = 'countdown-{{ section.id }}';
    var mode = {{ section.settings.mode | json }};
    var durationMinutes = {{ section.settings.evergreen_minutes | default: 30 }};
    var endDate = {{ section.settings.end_date | json }};
    var endTime = {{ section.settings.end_time | json }};
    var expiredMessage = {{ section.settings.expired_message | json }};
    var storageKey = 'cmp_countdown_{{ section.id }}';

    function pad(n) {
      return n < 10 ? '0' + n : '' + n;
    }

    function computeEvergreenEnd() {
      var ms = Date.now() + (durationMinutes * 60 * 1000);
      try { localStorage.setItem(storageKey, String(ms)); } catch (e) {}
      return ms;
    }

    function computeEndTime() {
      if (mode === 'fixed') {
        var parsed = Date.parse((endDate || '') + 'T' + (endTime || '00:00') + ':00');
        if (!isNaN(parsed) && parsed > Date.now()) return parsed;
      }

      try {
        var stored = localStorage.getItem(storageKey);
        if (stored) {
          var parsedStored = parseInt(stored, 10);
          if (!isNaN(parsedStored) && parsedStored > Date.now()) return parsedStored;
        }
      } catch (e) {}

      return computeEvergreenEnd();
    }

    function initCountdown() {
      var el = document.getElementById(sectionId);
      if (!el || el.dataset.countdownInitialized === 'true') return;

      var timerEl = el.querySelector('[data-countdown-timer]');
      var expiredEl = el.querySelector('[data-countdown-expired]');
      var daysEl = el.querySelector('[data-countdown-days]');
      var hoursEl = el.querySelector('[data-countdown-hours]');
      var minsEl = el.querySelector('[data-countdown-mins]');
      var secsEl = el.querySelector('[data-countdown-secs]');

      if (!timerEl || !expiredEl || !daysEl || !hoursEl || !minsEl || !secsEl) return;

      el.dataset.countdownInitialized = 'true';
      var endStamp = computeEndTime();

      function tick() {
        var diff = endStamp - Date.now();

        if (diff <= 0) {
          if (mode === 'fixed' && expiredMessage && expiredMessage.trim() !== '') {
            timerEl.style.display = 'none';
            expiredEl.style.display = '';
            return;
          }

          endStamp = computeEvergreenEnd();
          diff = endStamp - Date.now();
        }

        var total = Math.floor(diff / 1000);
        var days = Math.floor(total / 86400);
        var hours = Math.floor((total % 86400) / 3600);
        var mins = Math.floor((total % 3600) / 60);
        var secs = total % 60;

        daysEl.textContent = pad(days);
        hoursEl.textContent = pad(hours);
        minsEl.textContent = pad(mins);
        secsEl.textContent = pad(secs);

        if (diff < 3600000) el.classList.add('cmp-countdown--urgent');
        setTimeout(tick, 1000);
      }

      tick();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCountdown);
    } else {
      initCountdown();
    }

    document.addEventListener('shopify:section:load', initCountdown);
  })();
</script>

{% schema %}
{
  "name": "Countdown Timer",
  "tag": "section",
  "class": "cmp-section-countdown",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This Special Offer Expires In..."
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Timer mode",
      "options": [
        { "value": "fixed", "label": "Fixed end date" },
        { "value": "evergreen", "label": "Evergreen (per visitor)" }
      ],
      "default": "evergreen"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date (YYYY-MM-DD)",
      "default": "2026-12-31"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "End time (HH:MM)",
      "default": "23:59"
    },
    {
      "type": "range",
      "id": "evergreen_minutes",
      "label": "Timer duration (minutes)",
      "min": 5,
      "max": 1440,
      "step": 5,
      "default": 30
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "Expired message",
      "default": "This offer has expired."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1D3557"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Countdown Timer"
    }
  ]
}
{% endschema %}
