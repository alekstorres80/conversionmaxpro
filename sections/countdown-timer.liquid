<div class="cmp-countdown cmp-section"
  style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }}; padding: 40px 20px; text-align: center;"
  data-countdown-section="{{ section.id }}"
  data-countdown-mode="{{ section.settings.mode }}"
  data-countdown-duration="{{ section.settings.evergreen_minutes }}"
  data-countdown-storage-key="cmp_countdown_{{ section.id }}"
  data-countdown-end="{{ section.settings.end_date }}T{{ section.settings.end_time }}"
>
  <div class="cmp-container">
    {% if section.settings.heading != blank %}
      <h2 style="color: {{ section.settings.text_color }}; margin-bottom: 20px;">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="cmp-countdown__timer" style="display: flex; justify-content: center; gap: 20px;">
      <div class="cmp-countdown__unit">
        <span class="cmp-countdown__number" data-countdown-days style="font-size: 2rem; font-weight: bold;">00</span>
        <br>
        <span class="cmp-countdown__label">Days</span>
      </div>
      <span style="font-size: 2rem;">:</span>
      <div class="cmp-countdown__unit">
        <span class="cmp-countdown__number" data-countdown-hours style="font-size: 2rem; font-weight: bold;">00</span>
        <br>
        <span class="cmp-countdown__label">Hours</span>
      </div>
      <span style="font-size: 2rem;">:</span>
      <div class="cmp-countdown__unit">
        <span class="cmp-countdown__number" data-countdown-mins style="font-size: 2rem; font-weight: bold;">00</span>
        <br>
        <span class="cmp-countdown__label">Minutes</span>
      </div>
      <span style="font-size: 2rem;">:</span>
      <div class="cmp-countdown__unit">
        <span class="cmp-countdown__number" data-countdown-secs style="font-size: 2rem; font-weight: bold;">00</span>
        <br>
        <span class="cmp-countdown__label">Seconds</span>
      </div>
    </div>

    <div class="cmp-countdown__expired" style="display: none;">
      {{ section.settings.expired_message }}
    </div>
  </div>
</div>

<script src="{{ 'countdown-timer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Countdown Timer",
  "tag": "section",
  "class": "cmp-section-countdown",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This Special Offer Expires In..."
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Timer mode",
      "options": [
        { "value": "fixed", "label": "Fixed end date" },
        { "value": "evergreen", "label": "Evergreen (per visitor)" }
      ],
      "default": "evergreen"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "End date (YYYY-MM-DD)",
      "default": "2026-12-31"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "End time (HH:MM)",
      "default": "23:59"
    },
    {
      "type": "range",
      "id": "evergreen_minutes",
      "label": "Timer duration (minutes)",
      "min": 5,
      "max": 1440,
      "step": 5,
      "default": 30
    },
    {
      "type": "text",
      "id": "expired_message",
      "label": "Expired message",
      "default": "This offer has expired."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#1D3557"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Countdown Timer"
    }
  ]
}
{% endschema %}
