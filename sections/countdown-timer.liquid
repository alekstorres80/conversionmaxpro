<div class="cmp-countdown">
  <h2>{{ section.settings.heading }}</h2>
</div>

{% schema %}
{
  "name": "Countdown Timer",
  "tag": "section",
  "class": "cmp-section-countdown",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This Special Offer Expires In..."
    }
  ],
  "presets": [
    {
      "name": "Countdown Timer"
    }
  ]
}
{% endschema %}
