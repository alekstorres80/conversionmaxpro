{%- comment -%}
  FAQ Accordion — ConversionMax Pro
  Question/answer pairs with smooth expand/collapse animation.
{%- endcomment -%}

<div class="cmp-faq cmp-section">
  <div class="cmp-container">
    {%- if section.settings.heading != blank -%}
      <div class="cmp-faq__heading">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p style="color: var(--color-text-light); margin-top: 8px;">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="cmp-faq__list">
      {%- for block in section.blocks -%}
        <li class="cmp-faq__item" {{ block.shopify_attributes }}>
          <button class="cmp-faq__question" type="button" aria-expanded="false">
            <span>{{ block.settings.question }}</span>
            <span class="cmp-faq__icon">+</span>
          </button>
          <div class="cmp-faq__answer" role="region">
            <div class="cmp-faq__answer-inner">
              {{ block.settings.answer }}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "cmp-section-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Got questions? We've got answers."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does this product work?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Our product works by leveraging proven techniques to deliver results you can see and feel.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "How does this product work?",
            "answer": "<p>Our product works by leveraging proven techniques to deliver results you can see and feel.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Is there a money-back guarantee?",
            "answer": "<p>Yes! We offer a full 60-day money-back guarantee.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "How long does shipping take?",
            "answer": "<p>Orders are processed within 1-2 business days. Domestic shipping typically takes 3-5 business days.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
