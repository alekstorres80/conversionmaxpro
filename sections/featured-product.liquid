{%- comment -%}
  Featured Product — ConversionMax Pro
  Hero-style product spotlight for the homepage.
  Shows product image, title, price, description, and CTA.
{%- endcomment -%}

{%- liquid
  assign product = section.settings.product
  assign layout = section.settings.layout
  assign bg_color = section.settings.bg_color
-%}

<section
  id="featured-product-{{ section.id }}"
  class="cmp-featured-product cmp-section{% if layout == 'image-right' %} cmp-featured-product--reversed{% endif %}"
  style="background-color: {{ bg_color }};"
>
  <div class="cmp-container">
    {%- if section.settings.badge_text != blank -%}
      <div class="cmp-featured-product__badge">{{ section.settings.badge_text }}</div>
    {%- endif -%}

    <div class="cmp-featured-product__grid">
      {%- comment -%} Image {%- endcomment -%}
      <div class="cmp-featured-product__media">
        {%- if product != blank and product.featured_image -%}
          <img
            src="{{ product.featured_image | image_url: width: 800 }}"
            srcset="{{ product.featured_image | image_url: width: 400 }} 400w,
                    {{ product.featured_image | image_url: width: 600 }} 600w,
                    {{ product.featured_image | image_url: width: 800 }} 800w"
            sizes="(max-width: 768px) 100vw, 50vw"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            width="{{ product.featured_image.width }}"
            height="{{ product.featured_image.height }}"
            loading="lazy"
          >
        {%- elsif section.settings.custom_image != blank -%}
          <img
            src="{{ section.settings.custom_image | image_url: width: 800 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
          >
        {%- else -%}
          <div class="cmp-featured-product__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'cmp-placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Content {%- endcomment -%}
      <div class="cmp-featured-product__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cmp-featured-product__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h2 class="cmp-featured-product__title">
          {%- if product != blank -%}
            {{ product.title }}
          {%- else -%}
            {{ section.settings.heading | default: 'Featured Product' }}
          {%- endif -%}
        </h2>

        {%- if product != blank -%}
          <div class="cmp-featured-product__price">
            {%- if product.compare_at_price > product.price -%}
              <span class="cmp-featured-product__price--compare">{{ product.compare_at_price | money }}</span>
            {%- endif -%}
            <span class="cmp-featured-product__price--current{% if product.compare_at_price > product.price %} cmp-featured-product__price--sale{% endif %}">
              {{ product.price | money }}
            </span>
            {%- if product.compare_at_price > product.price -%}
              {%- assign save_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
              <span class="cmp-featured-product__price--save">Save {{ save_pct }}%</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="cmp-featured-product__desc">{{ section.settings.description }}</div>
        {%- elsif product != blank and product.description != blank -%}
          <div class="cmp-featured-product__desc">{{ product.description | strip_html | truncate: 200 }}</div>
        {%- endif -%}

        {%- comment -%} Highlight bullets {%- endcomment -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="cmp-featured-product__highlights">
            {%- for block in section.blocks -%}
              {%- if block.type == 'highlight' and block.settings.text != blank -%}
                <li class="cmp-featured-product__highlight" {{ block.shopify_attributes }}>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-success, #2D6A4F)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {{ block.settings.text }}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="cmp-featured-product__actions">
          {%- if product != blank -%}
            <a href="{{ product.url }}" class="cmp-btn cmp-btn--primary cmp-btn--large">
              {{ section.settings.cta_text | default: 'Shop Now' }}
            </a>
          {%- elsif section.settings.cta_link != blank -%}
            <a href="{{ section.settings.cta_link }}" class="cmp-btn cmp-btn--primary cmp-btn--large">
              {{ section.settings.cta_text | default: 'Shop Now' }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cmp-featured-product {
    padding: var(--section-spacing, 60px) 0;
  }
  .cmp-featured-product__badge {
    display: inline-block;
    background: var(--color-primary, #1B7FC3);
    color: #fff;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 24px;
  }
  .cmp-featured-product__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .cmp-featured-product--reversed .cmp-featured-product__grid {
    direction: rtl;
  }
  .cmp-featured-product--reversed .cmp-featured-product__grid > * {
    direction: ltr;
  }
  .cmp-featured-product__media img {
    width: 100%;
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.1);
  }
  .cmp-featured-product__placeholder {
    background: var(--color-bg-alt, #F8F9FA);
    border-radius: 12px;
    padding: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cmp-featured-product__placeholder .cmp-placeholder-svg {
    width: 100%;
    max-width: 400px;
    fill: var(--color-border, #DEE2E6);
  }
  .cmp-featured-product__eyebrow {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary, #1B7FC3);
    margin-bottom: 8px;
  }
  .cmp-featured-product__title {
    font-size: 2.2rem;
    margin-bottom: 16px;
    line-height: 1.15;
  }
  .cmp-featured-product__price {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 1.4rem;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .cmp-featured-product__price--compare {
    text-decoration: line-through;
    color: var(--color-text-light, #6C757D);
    font-size: 1.1rem;
  }
  .cmp-featured-product__price--sale {
    color: var(--color-primary, #1B7FC3);
    font-weight: 700;
  }
  .cmp-featured-product__price--current {
    font-weight: 700;
    color: var(--color-heading, #1D3557);
  }
  .cmp-featured-product__price--save {
    background: var(--color-primary, #1B7FC3);
    color: #fff;
    padding: 2px 10px;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .cmp-featured-product__desc {
    color: var(--color-text-light, #6C757D);
    line-height: 1.7;
    margin-bottom: 20px;
  }
  .cmp-featured-product__highlights {
    list-style: none;
    margin-bottom: 28px;
  }
  .cmp-featured-product__highlight {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
    font-size: 0.95rem;
  }
  .cmp-featured-product__actions {
    display: flex;
    gap: 12px;
  }
  @media (max-width: 768px) {
    .cmp-featured-product__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .cmp-featured-product--reversed .cmp-featured-product__grid {
      direction: ltr;
    }
    .cmp-featured-product__title {
      font-size: 1.6rem;
    }
  }
</style>

{% schema %}
{
  "name": "Featured Product",
  "tag": "section",
  "class": "cmp-section-featured-product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Best Seller",
      "info": "e.g., Best Seller, New Arrival, Limited Edition"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Introducing"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (fallback)",
      "default": "Featured Product",
      "info": "Used when no product is selected"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Custom description",
      "info": "Overrides the product description if filled in"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link (fallback)",
      "info": "Used when no product is selected"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "image-left", "label": "Image left" },
        { "value": "image-right", "label": "Image right" }
      ],
      "default": "image-left"
    },
    {
      "type": "image_picker",
      "id": "custom_image",
      "label": "Custom image",
      "info": "Overrides the product image if set"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on all orders"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Product",
      "blocks": [
        { "type": "highlight", "settings": { "text": "Free shipping on all orders" } },
        { "type": "highlight", "settings": { "text": "30-day money-back guarantee" } },
        { "type": "highlight", "settings": { "text": "24/7 customer support" } }
      ]
    }
  ]
}
{% endschema %}
