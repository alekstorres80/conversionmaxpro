{%- comment -%}
  Site Footer — ConversionMax Pro
  Inspired by 1.8 ThemeX (2017): quick links, contact, social, newsletter, payment icons, copyright.
{%- endcomment -%}

<footer class="cmp-site-footer" role="contentinfo">
  <div class="cmp-container">

    <div class="cmp-site-footer__grid">

      {%- if settings.footer_quicklinks_enable and settings.footer_quicklinks_linklist != blank -%}
        <div class="cmp-site-footer__col cmp-site-footer__col--links">
          {%- if settings.footer_quicklinks_heading != blank -%}
            <h3 class="cmp-site-footer__heading">{{ settings.footer_quicklinks_heading }}</h3>
          {%- endif -%}
          <ul class="cmp-site-footer__menu">
            {%- for link in linklists[settings.footer_quicklinks_linklist].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if settings.footer_contact_enable -%}
        <div class="cmp-site-footer__col cmp-site-footer__col--contact">
          {%- if settings.footer_contact_heading != blank -%}
            <h3 class="cmp-site-footer__heading">{{ settings.footer_contact_heading }}</h3>
          {%- endif -%}
          {%- if settings.footer_contact_text != blank -%}
            <div class="cmp-site-footer__rte rte">{{ settings.footer_contact_text }}</div>
          {%- endif -%}

          {%- if settings.footer_social_enable -%}
            {%- assign has_social = false -%}
            {%- if settings.social_facebook != blank or settings.social_instagram != blank or settings.social_twitter != blank or settings.social_youtube != blank or settings.social_tiktok != blank -%}
              {%- assign has_social = true -%}
            {%- endif -%}
            {%- if has_social -%}
              <ul class="cmp-site-footer__social">
                {%- if settings.social_facebook != blank -%}
                  <li>
                    <a href="{{ settings.social_facebook }}" aria-label="Facebook" target="_blank" rel="noopener">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.3c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_instagram != blank -%}
                  <li>
                    <a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor"/></svg>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_twitter != blank -%}
                  <li>
                    <a href="{{ settings.social_twitter }}" aria-label="X (Twitter)" target="_blank" rel="noopener">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2H21l-6.522 7.452L22 22h-6.95l-4.7-6.156L4.86 22H2.1l6.99-7.985L2 2h6.95l4.247 5.612L18.244 2zm-1.218 18h1.706L7.06 4H5.231L17.026 20z"/></svg>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_youtube != blank -%}
                  <li>
                    <a href="{{ settings.social_youtube }}" aria-label="YouTube" target="_blank" rel="noopener">
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 12s0-3.3-.4-4.9a2.5 2.5 0 0 0-1.8-1.8C19.1 5 12 5 12 5s-7.1 0-8.8.4A2.5 2.5 0 0 0 1.4 7.2C1 8.7 1 12 1 12s0 3.3.4 4.9a2.5 2.5 0 0 0 1.8 1.8C4.9 19 12 19 12 19s7.1 0 8.8-.4a2.5 2.5 0 0 0 1.8-1.8c.4-1.6.4-4.9.4-4.9zM10 15.4V8.6l5.7 3.4-5.7 3.4z"/></svg>
                    </a>
                  </li>
                {%- endif -%}
                {%- if settings.social_tiktok != blank -%}
                  <li>
                    <a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.6 6.7a5.4 5.4 0 0 1-3.3-1.1 5.5 5.5 0 0 1-2-3.6h-3.6v13.5a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V9.4a6.4 6.4 0 1 0 5.5 6.4V9a8.7 8.7 0 0 0 5.2 1.7V6.7z"/></svg>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if settings.footer_newsletter_enable -%}
        <div class="cmp-site-footer__col cmp-site-footer__col--newsletter">
          {%- if settings.footer_newsletter_heading != blank -%}
            <h3 class="cmp-site-footer__heading">{{ settings.footer_newsletter_heading }}</h3>
          {%- endif -%}
          {%- if settings.footer_newsletter_text != blank -%}
            <p class="cmp-site-footer__newsletter-text">{{ settings.footer_newsletter_text }}</p>
          {%- endif -%}
          {%- form 'customer', class: 'cmp-site-footer__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="cmp-site-footer__newsletter-row">
              <input
                type="email"
                name="contact[email]"
                class="cmp-site-footer__newsletter-input"
                placeholder="your@email.com"
                aria-label="Email address"
                required
              >
              <button type="submit" class="cmp-btn cmp-btn--primary cmp-site-footer__newsletter-btn">Subscribe</button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="cmp-site-footer__newsletter-success">Thanks for subscribing!</p>
            {%- elsif form.errors -%}
              <p class="cmp-site-footer__newsletter-error">{{ form.errors.translated_fields.email }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

    </div>

    <hr class="cmp-site-footer__hr">

    <div class="cmp-site-footer__bottom">
      <div class="cmp-site-footer__copy">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: '/' }}.
        {%- if settings.footer_legal_enable and settings.footer_legal_linklist != blank -%}
          <ul class="cmp-site-footer__legal">
            {%- for link in linklists[settings.footer_legal_linklist].links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if settings.footer_show_powered_by -%}
          <span class="cmp-site-footer__powered">{{ powered_by_link }}</span>
        {%- endif -%}
      </div>

      {%- if settings.footer_payment_icons_enable and shop.enabled_payment_types.size > 0 -%}
        <ul class="cmp-site-footer__payments" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'cmp-site-footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "settings": []
}
{% endschema %}
