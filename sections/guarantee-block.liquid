{%- comment -%}
  Guarantee Block — ConversionMax Pro
  Icon + headline + body text, fully customizable in theme editor.
{%- endcomment -%}

<section
  id="guarantee-{{ section.id }}"
  class="cmp-guarantee cmp-section"
  style="{% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}"
>
  <div class="cmp-container">
    <div class="cmp-guarantee__inner" style="{% if section.settings.border_color != blank %}border-color: {{ section.settings.border_color }};{% endif %}">

      {%- comment -%} Icon {%- endcomment -%}
      <div class="cmp-guarantee__icon">
        {%- if section.settings.icon_image != blank -%}
          <img
            src="{{ section.settings.icon_image | image_url: width: 160 }}"
            alt="{{ section.settings.headline | escape }}"
            width="80"
            height="80"
            loading="lazy"
          >
        {%- else -%}
          <div class="cmp-guarantee__icon--default" style="{% if section.settings.icon_bg_color != blank %}background-color: {{ section.settings.icon_bg_color }};{% endif %}">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Text {%- endcomment -%}
      <div class="cmp-guarantee__text">
        {%- if section.settings.headline != blank -%}
          <h3 class="cmp-guarantee__headline" style="{% if section.settings.headline_color != blank %}color: {{ section.settings.headline_color }};{% endif %}">
            {{ section.settings.headline }}
          </h3>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="cmp-guarantee__body">
            {{ section.settings.body }}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} AI Copywriter — editor only {%- endcomment -%}
    {%- if request.design_mode -%}
      <div class="cmp-ai-panel-mount" data-ai-section="guarantee"></div>
      <script>
        (function() {
          if (!window.CMP || !CMP.ai || !CMP.ai.createPanel) {
            document.addEventListener('DOMContentLoaded', init);
          } else { init(); }
          function init() {
            if (!window.CMP || !CMP.ai || !CMP.ai.createPanel) return;
            var mount = document.querySelector('[data-ai-section="guarantee"]');
            if (mount && !mount.hasChildNodes()) {
              CMP.ai.createPanel({ container: mount, sectionType: 'guarantee' });
            }
          }
        })();
      </script>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Guarantee Block",
  "tag": "section",
  "class": "cmp-section-guarantee",
  "settings": [
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Custom icon/badge image",
      "info": "Upload a custom guarantee badge. Leave blank to use the default shield icon."
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Default icon background color",
      "default": "#2D6A4F",
      "info": "Only used when no custom image is uploaded."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "100% Money-Back Guarantee"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>We're so confident you'll love this product that we offer a full 60-day money-back guarantee. If you're not completely satisfied, simply contact our support team for a hassle-free refund. No questions asked.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline color",
      "default": "#2D6A4F"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#2D6A4F"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Guarantee Block"
    }
  ]
}
{% endschema %}
