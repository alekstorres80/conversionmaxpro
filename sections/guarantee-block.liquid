{%- comment -%}
  Guarantee Block — ConversionMax Pro
  Icon + headline + body text, fully customizable in theme editor.
{%- endcomment -%}

<div class="cmp-guarantee cmp-section" style="{% if section.settings.bg_color != blank %}background-color: {{ section.settings.bg_color }};{% endif %}">
  <div class="cmp-container">
    <div class="cmp-guarantee__inner" style="{% if section.settings.border_color != blank %}border-color: {{ section.settings.border_color }};{% endif %}">

      <div class="cmp-guarantee__icon">
        {%- if section.settings.icon_image != blank -%}
          <img
            src="{{ section.settings.icon_image | image_url: width: 160 }}"
            alt="{{ section.settings.headline | escape }}"
            width="80"
            height="80"
            loading="lazy"
          >
        {%- else -%}
          <div class="cmp-guarantee__icon--default" style="{% if section.settings.icon_bg_color != blank %}background-color: {{ section.settings.icon_bg_color }};{% endif %} width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 2rem;">
            &#x1F6E1;
          </div>
        {%- endif -%}
      </div>

      <div class="cmp-guarantee__text">
        {%- if section.settings.headline != blank -%}
          <h3 class="cmp-guarantee__headline" style="{% if section.settings.headline_color != blank %}color: {{ section.settings.headline_color }};{% endif %}">
            {{ section.settings.headline }}
          </h3>
        {%- endif -%}

        {%- if section.settings.body != blank -%}
          <div class="cmp-guarantee__body">
            {{ section.settings.body }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Guarantee Block",
  "tag": "section",
  "class": "cmp-section-guarantee",
  "settings": [
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "image_picker",
      "id": "icon_image",
      "label": "Custom icon/badge image"
    },
    {
      "type": "color",
      "id": "icon_bg_color",
      "label": "Default icon background color",
      "default": "#2D6A4F"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "100% Money-Back Guarantee"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>We offer a full 60-day money-back guarantee. If you're not completely satisfied, contact our support team for a hassle-free refund. No questions asked.</p>"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "headline_color",
      "label": "Headline color",
      "default": "#2D6A4F"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#2D6A4F"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "Guarantee Block"
    }
  ]
}
{% endschema %}
