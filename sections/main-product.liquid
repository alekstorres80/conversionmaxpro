{%- liquid
  assign product_obj = product
  assign current_variant = product_obj.selected_or_first_available_variant
  assign primary_image = current_variant.featured_image
  if primary_image == blank
    assign primary_image = product_obj.featured_image
  endif
  if primary_image == blank and product_obj.images.size > 0
    assign primary_image = product_obj.images.first
  endif
-%}

{%- if product_obj != blank -%}
<section class="cmp-main-product cmp-section" id="cmp-main-product-{{ section.id }}">
  <div class="cmp-container">
    <div class="cmp-main-product__grid">
      <div class="cmp-main-product__media">
        {%- if primary_image != blank -%}
          <img
            id="cmp-main-product-image-{{ section.id }}"
            src="{{ primary_image | image_url: width: 1200 }}"
            alt="{{ primary_image.alt | default: product_obj.title | escape }}"
            width="{{ primary_image.width }}"
            height="{{ primary_image.height }}"
            loading="eager"
          >

          {%- if product_obj.images.size > 1 -%}
            <div class="cmp-main-product__thumbs" data-main-product-thumbs>
              {%- for image in product_obj.images -%}
                <button
                  type="button"
                  class="cmp-main-product__thumb{% if image.id == primary_image.id %} is-active{% endif %}"
                  data-image-url="{{ image | image_url: width: 1200 }}"
                  aria-label="View image {{ forloop.index }}"
                >
                  <img
                    src="{{ image | image_url: width: 180 }}"
                    alt="{{ image.alt | default: product_obj.title | escape }}"
                    width="64"
                    height="64"
                    loading="lazy"
                  >
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="cmp-main-product__placeholder">{{ 'product-1' | placeholder_svg_tag: 'cmp-placeholder-svg' }}</div>
        {%- endif -%}
      </div>

      <div class="cmp-main-product__content">
        {%- if section.settings.badge_text != blank -%}
          <span class="cmp-main-product__badge">{{ section.settings.badge_text }}</span>
        {%- endif -%}

        {%- if section.settings.eyebrow_text != blank -%}
          <p class="cmp-main-product__eyebrow">{{ section.settings.eyebrow_text }}</p>
        {%- elsif section.settings.show_vendor and product_obj.vendor != blank -%}
          <p class="cmp-main-product__eyebrow">{{ product_obj.vendor }}</p>
        {%- endif -%}

        <h1 class="cmp-main-product__title">{{ product_obj.title }}</h1>

        {%- if section.settings.show_rating -%}
          <div class="cmp-main-product__rating" aria-label="Product rating">
            <span class="cmp-main-product__stars">{{ section.settings.stars_text }}</span>
            <span class="cmp-main-product__rating-text">{{ section.settings.rating_text }}</span>
          </div>
        {%- endif -%}

        <div class="cmp-main-product__price" id="cmp-main-product-price-{{ section.id }}" data-price-area>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="cmp-main-product__price-compare" data-price-compare>{{ current_variant.compare_at_price | money }}</span>
          {%- else -%}
            <span class="cmp-main-product__price-compare" data-price-compare style="display:none"></span>
          {%- endif -%}
          <span class="cmp-main-product__price-current" data-price-current>{{ current_variant.price | money }}</span>
        </div>

        {%- if section.settings.show_description -%}
          <div class="cmp-main-product__description">
            {%- if section.settings.custom_description != blank -%}
              {{ section.settings.custom_description }}
            {%- else -%}
              {{ product_obj.description | strip_html | truncate: section.settings.description_chars }}
            {%- endif -%}
          </div>
          {%- if section.settings.custom_highlights != blank -%}
            <ul class="cmp-main-product__highlights">
              {%- assign highlights_lines = section.settings.custom_highlights | newline_to_br | split: '<br />' -%}
              {%- for line in highlights_lines -%}
                {%- assign item = line | strip -%}
                {%- if item != blank -%}
                  <li>{{ item }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- endif -%}

        <div class="cmp-main-product__review-app-blocks">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
            {%- endcase -%}
          {%- endfor -%}
        </div>

        <form method="post" action="/cart/add" class="cmp-main-product__form" data-main-product-form>
          {%- if product_obj.variants.size > 1 -%}
            <label for="cmp-main-product-variant-{{ section.id }}" class="cmp-main-product__label">{{ section.settings.variant_label }}</label>
            <select
              id="cmp-main-product-variant-{{ section.id }}"
              name="id"
              class="cmp-main-product__select"
              data-main-product-variant
            >
              {%- for variant in product_obj.variants -%}
                <option
                  value="{{ variant.id }}"
                  data-price="{{ variant.price }}"
                  data-compare="{{ variant.compare_at_price | default: 0 }}"
                  data-image="{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1200 }}{% endif %}"
                  {% if variant.id == current_variant.id %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title }}{% unless variant.available %} - Sold out{% endunless %}
                </option>
              {%- endfor -%}
            </select>
          {%- else -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {%- endif -%}

          <label for="cmp-main-product-qty-{{ section.id }}" class="cmp-main-product__label">Quantity</label>
          <input
            id="cmp-main-product-qty-{{ section.id }}"
            type="number"
            name="quantity"
            min="1"
            value="1"
            class="cmp-main-product__qty"
          >

          <button type="submit" class="cmp-btn cmp-btn--primary cmp-btn--large cmp-main-product__button" {% unless current_variant.available %}disabled{% endunless %}>
            {% if current_variant.available %}{{ section.settings.button_text }}{% else %}Sold out{% endif %}
          </button>

          {%- if section.settings.show_secure_badges -%}
            <div class="cmp-main-product__trust">
              {%- if section.settings.trust_badges_image != blank -%}
                <img
                  class="cmp-main-product__trust-image"
                  src="{{ section.settings.trust_badges_image | image_url: width: 900 }}"
                  alt="Guaranteed safe checkout"
                  loading="lazy"
                >
              {%- else -%}
                <div class="cmp-main-product__trust-items">
                  <span>{{ section.settings.trust_item_1 }}</span>
                  <span>{{ section.settings.trust_item_2 }}</span>
                  <span>{{ section.settings.trust_item_3 }}</span>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.show_inline_timer -%}
            <div
              class="cmp-main-product__timer"
              data-inline-countdown
              data-duration="{{ section.settings.timer_minutes | default: 30 }}"
              data-storage-key="cmp_main_timer_{{ product_obj.id }}_{{ section.id }}"
            >
              <p class="cmp-main-product__timer-title">{{ section.settings.timer_heading }}</p>
              <div class="cmp-main-product__timer-row">
                <div class="cmp-main-product__timer-unit"><span data-inline-days>00</span><small>Days</small></div>
                <span class="cmp-main-product__timer-sep">:</span>
                <div class="cmp-main-product__timer-unit"><span data-inline-hours>00</span><small>Hours</small></div>
                <span class="cmp-main-product__timer-sep">:</span>
                <div class="cmp-main-product__timer-unit"><span data-inline-mins>00</span><small>Minutes</small></div>
                <span class="cmp-main-product__timer-sep">:</span>
                <div class="cmp-main-product__timer-unit"><span data-inline-secs>00</span><small>Seconds</small></div>
              </div>
            </div>
          {%- endif -%}
        </form>

      </div>
    </div>
  </div>
</section>

{%- comment -%} AI Copywriter — editor only {%- endcomment -%}
{%- if request.design_mode -%}
  <script data-ai-page-product type="application/json">
    {
      "title": {{ product_obj.title | json }},
      "description": {{ product_obj.description | strip_html | json }},
      "vendor": {{ product_obj.vendor | json }},
      "type": {{ product_obj.type | json }},
      "price": {{ product_obj.price | money | json }},
      "compare_at_price": {{ product_obj.compare_at_price | money | json }},
      "tags": {{ product_obj.tags | json }}
    }
  </script>
  <div class="cmp-ai-panel-mount" data-ai-section="main-product" data-section-id="{{ section.id }}"></div>
  <script>
    (function() {
      if (!window.CMP || !CMP.ai || !CMP.ai.createPanel) {
        document.addEventListener('DOMContentLoaded', init);
      } else { init(); }
      function init() {
        if (!window.CMP || !CMP.ai || !CMP.ai.createPanel) return;
        // Feed page product into AI config if no theme-settings product is set
        if (!CMP.ai.config.product || !CMP.ai.config.product.title) {
          var pageProductEl = document.querySelector('script[data-ai-page-product]');
          if (pageProductEl) {
            try {
              var pp = JSON.parse(pageProductEl.textContent);
              if (pp && pp.title) {
                CMP.ai.config.product = pp;
                CMP.ai.config.productName = pp.title;
                CMP.ai.config.productDesc = pp.description || '';
              }
            } catch(e) {}
          }
        }
        var mount = document.querySelector('[data-ai-section="main-product"]');
        if (mount && !mount.hasChildNodes()) {
          CMP.ai.createPanel({ container: mount, sectionType: 'main-product', sectionId: '{{ section.id }}' });
        }
      }
    })();
  </script>
{%- endif -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var sectionId = '{{ section.id }}';
    var sectionRoot = document.querySelector('#cmp-main-product-' + sectionId);
    if (!sectionRoot) return;

    var variantSelect = sectionRoot.querySelector('[data-main-product-variant]');
    var priceCurrent = sectionRoot.querySelector('[data-price-current]');
    var priceCompare = sectionRoot.querySelector('[data-price-compare]');
    var mainImage = sectionRoot.querySelector('#cmp-main-product-image-' + sectionId);
    var thumbButtons = sectionRoot.querySelectorAll('[data-main-product-thumbs] .cmp-main-product__thumb');

    function formatMoney(cents) {
      return '$' + (Number(cents || 0) / 100).toFixed(2);
    }

    function setMainImage(imageUrl) {
      if (mainImage && imageUrl) {
        mainImage.setAttribute('src', imageUrl);
      }
    }

    if (variantSelect) {
      variantSelect.addEventListener('change', function () {
        var opt = variantSelect.options[variantSelect.selectedIndex];
        var price = opt.getAttribute('data-price');
        var compare = opt.getAttribute('data-compare');
        var imageUrl = opt.getAttribute('data-image');

        if (priceCurrent) priceCurrent.textContent = formatMoney(price);

        if (priceCompare) {
          if (compare && Number(compare) > Number(price)) {
            priceCompare.style.display = '';
            priceCompare.textContent = formatMoney(compare);
          } else {
            priceCompare.style.display = 'none';
            priceCompare.textContent = '';
          }
        }

        if (imageUrl) setMainImage(imageUrl);
      });
    }

    if (thumbButtons.length) {
      thumbButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var imageUrl = btn.getAttribute('data-image-url');
          setMainImage(imageUrl);
          thumbButtons.forEach(function (other) { other.classList.remove('is-active'); });
          btn.classList.add('is-active');
        });
      });
    }

    var timer = sectionRoot.querySelector('[data-inline-countdown]');
    if (timer) {
      var storageKey = timer.getAttribute('data-storage-key');
      var durationMin = Number(timer.getAttribute('data-duration') || 30);
      var now = Date.now();
      var target = Number(localStorage.getItem(storageKey) || 0);
      if (!target || target <= now) {
        target = now + durationMin * 60 * 1000;
        localStorage.setItem(storageKey, String(target));
      }

      var dayEl = timer.querySelector('[data-inline-days]');
      var hourEl = timer.querySelector('[data-inline-hours]');
      var minEl = timer.querySelector('[data-inline-mins]');
      var secEl = timer.querySelector('[data-inline-secs]');

      function pad(num) {
        return num < 10 ? '0' + num : String(num);
      }

      function tick() {
        var remaining = Math.max(0, target - Date.now());
        var totalSeconds = Math.floor(remaining / 1000);
        var days = Math.floor(totalSeconds / 86400);
        var hours = Math.floor((totalSeconds % 86400) / 3600);
        var minutes = Math.floor((totalSeconds % 3600) / 60);
        var seconds = totalSeconds % 60;

        if (dayEl) dayEl.textContent = pad(days);
        if (hourEl) hourEl.textContent = pad(hours);
        if (minEl) minEl.textContent = pad(minutes);
        if (secEl) secEl.textContent = pad(seconds);
      }

      tick();
      setInterval(tick, 1000);
    }
  });
</script>

<style>
  .cmp-main-product { padding: 36px 0 18px; }
  .cmp-main-product__grid {
    display: grid;
    grid-template-columns: minmax(300px, 1fr) minmax(320px, 1fr);
    gap: 40px;
    align-items: start;
  }
  .cmp-main-product__media img {
    width: 100%;
    border-radius: 14px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }
  .cmp-main-product__thumbs {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .cmp-main-product__thumb {
    border: 2px solid var(--color-border, #d8dee4);
    border-radius: 10px;
    padding: 2px;
    background: #fff;
    cursor: pointer;
  }
  .cmp-main-product__thumb.is-active {
    border-color: var(--color-primary, #1B7FC3);
  }
  .cmp-main-product__thumb img {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: 8px;
    box-shadow: none;
  }
  .cmp-main-product__placeholder {
    border: 1px solid var(--color-border, #d8dee4);
    border-radius: 14px;
    padding: 40px;
    background: #fff;
  }
  .cmp-main-product__badge {
    display: inline-block;
    padding: 4px 12px;
    background: var(--color-primary, #1B7FC3);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 4px;
    margin-bottom: 10px;
  }
  .cmp-main-product__eyebrow {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary, #1B7FC3);
    margin-bottom: 8px;
    font-weight: 700;
  }
  .cmp-main-product__title {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.15;
    margin-bottom: 12px;
  }
  .cmp-main-product__rating {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }
  .cmp-main-product__stars { color: #f4b400; font-size: 1rem; line-height: 1; }
  .cmp-main-product__rating-text { color: var(--color-text-light, #6C757D); font-size: 0.95rem; }
  .cmp-main-product__price {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .cmp-main-product__price-current {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-heading, #1D3557);
  }
  .cmp-main-product__price-compare {
    text-decoration: line-through;
    color: var(--color-text-light, #6C757D);
    font-size: 1.1rem;
  }
  .cmp-main-product__description {
    color: var(--color-text, #1F2937);
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .cmp-main-product__highlights {
    margin: -8px 0 14px 18px;
    padding: 0;
    color: var(--color-heading, #1D3557);
  }
  .cmp-main-product__highlights li {
    margin: 4px 0;
    line-height: 1.45;
  }
  .cmp-main-product__form {
    display: grid;
    gap: 8px;
    max-width: 420px;
  }
  .cmp-main-product__label {
    font-size: 0.85rem;
    color: var(--color-text-light, #6C757D);
    font-weight: 700;
    margin-top: 6px;
  }
  .cmp-main-product__select,
  .cmp-main-product__qty {
    width: 100%;
    border: 1px solid var(--color-border, #d8dee4);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 1rem;
    background: #fff;
  }
  .cmp-main-product__qty { max-width: 120px; }
  .cmp-main-product__button { margin-top: 8px; width: 100%; }
  .cmp-main-product__timer {
    margin-top: 10px;
    background: #1d3557;
    border-radius: 10px;
    color: #fff;
    padding: 10px 12px;
    text-align: center;
  }
  .cmp-main-product__timer-title {
    margin: 0 0 8px;
    font-weight: 700;
    font-size: 0.95rem;
    color: #fff;
  }
  .cmp-main-product__timer-row {
    display: grid;
    grid-template-columns: repeat(7, auto);
    justify-content: center;
    align-items: center;
    gap: 8px;
  }
  .cmp-main-product__timer-unit span {
    display: inline-block;
    min-width: 38px;
    padding: 6px 8px;
    border-radius: 8px;
    background: rgba(255,255,255,0.16);
    font-size: 1rem;
    font-weight: 700;
  }
  .cmp-main-product__timer-unit small {
    display: block;
    margin-top: 4px;
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    opacity: 0.85;
  }
  .cmp-main-product__timer-sep {
    font-size: 1.2rem;
    font-weight: 700;
  }
  .cmp-main-product__review-app-blocks { margin-bottom: 6px; }
  .cmp-main-product__trust {
    margin-top: 10px;
    text-align: center;
  }
  .cmp-main-product__trust-image {
    max-width: 100%;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .cmp-main-product__trust-items {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--color-text-light, #6C757D);
    font-size: 0.9rem;
  }
  .cmp-main-product__trust-items span {
    border: 1px solid var(--color-border, #d8dee4);
    border-radius: 999px;
    padding: 6px 10px;
    background: #f8fafc;
  }
  @media (max-width: 900px) {
    .cmp-main-product__grid { grid-template-columns: 1fr; gap: 24px; }
    .cmp-main-product__button { width: 100%; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Main Product",
  "tag": "section",
  "class": "cmp-section-main-product",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "AI Copywriter Overrides",
      "info": "These fields are auto-filled when you click Apply in the AI Copywriter panel."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "info": "Small badge above the title (e.g. \"Best Seller\", \"Limited Edition\")"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "info": "Short label above the title. Overrides vendor when set."
    },
    {
      "type": "textarea",
      "id": "custom_description",
      "label": "Custom description",
      "info": "Overrides the default product description when set. Clear to revert to original."
    },
    {
      "type": "textarea",
      "id": "custom_highlights",
      "label": "Custom highlights (one per line)",
      "info": "Rendered as bullet points under the description."
    },
    {
      "type": "header",
      "content": "Product Info"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating row",
      "default": true
    },
    {
      "type": "text",
      "id": "stars_text",
      "label": "Stars text",
      "default": "*****"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating text",
      "default": "4.9/5 from 2,000+ reviews"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show product description preview",
      "default": true
    },
    {
      "type": "range",
      "id": "description_chars",
      "label": "Description max characters",
      "min": 80,
      "max": 360,
      "step": 20,
      "default": 200
    },
    {
      "type": "text",
      "id": "variant_label",
      "label": "Variant label",
      "default": "Choose option"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Add to cart button text",
      "default": "Add to Cart"
    },
    {
      "type": "checkbox",
      "id": "show_inline_timer",
      "label": "Show timer under button",
      "default": true
    },
    {
      "type": "text",
      "id": "timer_heading",
      "label": "Timer heading",
      "default": "Offer timer"
    },
    {
      "type": "range",
      "id": "timer_minutes",
      "label": "Timer minutes",
      "min": 5,
      "max": 180,
      "step": 5,
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "show_secure_badges",
      "label": "Show secure checkout",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "trust_badges_image",
      "label": "Trust badges image",
      "info": "Upload a \"Guaranteed Safe Checkout\" badge with payment icons (Visa, Mastercard, PayPal, etc.). When set, this replaces the text badges below."
    },
    {
      "type": "text",
      "id": "trust_item_1",
      "label": "Trust item 1 (text fallback)",
      "default": "SSL encrypted checkout",
      "info": "Only shown if no badge image is uploaded above"
    },
    {
      "type": "text",
      "id": "trust_item_2",
      "label": "Trust item 2 (text fallback)",
      "default": "30-day returns",
      "info": "Only shown if no badge image is uploaded above"
    },
    {
      "type": "text",
      "id": "trust_item_3",
      "label": "Trust item 3 (text fallback)",
      "default": "Fast shipping",
      "info": "Only shown if no badge image is uploaded above"
    }
  ],
  "presets": [
    {
      "name": "Main Product"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}

