<div class="cmp-quantity-breaks cmp-section">
  <div class="cmp-container">
    <h2>{{ section.settings.heading }}</h2>
  </div>
</div>

{% schema %}
{
  "name": "Quantity Breaks",
  "tag": "section",
  "class": "cmp-section-quantity-breaks",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose Your Package"
    }
  ],
  "presets": [
    {
      "name": "Quantity Breaks"
    }
  ]
}
{% endschema %}
