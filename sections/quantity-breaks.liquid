{%- comment -%}
  Quantity Breaks Section — ConversionMax Pro
  Buy 1/2/3+ with per-unit price drops. Highlights best value.
  Integrates with Shopify cart via AJAX.
{%- endcomment -%}

{%- liquid
  assign product = section.settings.product
  if product == blank and template.name == 'product'
    assign product = product
  endif
-%}

<section id="quantity-breaks-{{ section.id }}" class="cmp-quantity-breaks cmp-section" data-section-id="{{ section.id }}">
  <div class="cmp-container">
    {%- if section.settings.heading != blank -%}
      <div class="cmp-quantity-breaks__heading">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p style="color: var(--color-text-light); margin-top: 8px;">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cmp-quantity-breaks__grid" data-qb-grid>
      {%- for block in section.blocks -%}
        {%- liquid
          assign qty = block.settings.quantity
          assign price_cents = block.settings.price_cents
          assign compare_cents = block.settings.compare_price_cents
          assign per_unit = price_cents | divided_by: qty
          assign is_best = block.settings.best_value
          assign badge_text = block.settings.badge_text
          assign savings = compare_cents | minus: price_cents
        -%}

        <div
          class="cmp-qb-card{% if is_best %} cmp-qb-card--best{% endif %}{% if forloop.index == 1 %} cmp-qb-card--selected{% endif %}"
          data-qb-card
          data-quantity="{{ qty }}"
          data-price="{{ price_cents }}"
          data-variant-id="{{ block.settings.variant_id }}"
          {{ block.shopify_attributes }}
        >
          {%- if badge_text != blank -%}
            <span class="cmp-badge {% if is_best %}cmp-badge--primary{% else %}cmp-badge--success{% endif %} cmp-qb-card__badge">
              {{ badge_text }}
            </span>
          {%- endif -%}

          <div class="cmp-qb-card__quantity">{{ qty }}</div>
          <div class="cmp-qb-card__label">
            {%- if qty == 1 -%}
              Bottle
            {%- else -%}
              Bottles
            {%- endif -%}
          </div>

          {%- if compare_cents > price_cents -%}
            <div class="cmp-qb-card__original-price">
              <s>{{ compare_cents | money }}</s>
            </div>
          {%- endif -%}

          <div class="cmp-qb-card__price">{{ price_cents | money }}</div>

          {%- if qty > 1 -%}
            <div class="cmp-qb-card__per-unit">{{ per_unit | money }} each</div>
          {%- endif -%}

          {%- if savings > 0 -%}
            <div class="cmp-qb-card__savings">You save {{ savings | money }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="cmp-quantity-breaks__atc">
      <button
        class="cmp-btn cmp-btn--primary cmp-btn--large"
        data-qb-atc
        {% if section.blocks.size == 0 %}disabled{% endif %}
      >
        {{ section.settings.button_text | default: 'Add to Cart' }}
      </button>
    </div>
  </div>
</section>

<script src="{{ 'quantity-breaks.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Quantity Breaks",
  "tag": "section",
  "class": "cmp-section-quantity-breaks",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose Your Package"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Buy more and save more — free shipping on all orders"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Add to Cart — Best Deal!"
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Quantity Tier",
      "settings": [
        {
          "type": "text",
          "id": "quantity",
          "label": "Quantity",
          "default": "1"
        },
        {
          "type": "text",
          "id": "variant_id",
          "label": "Variant ID",
          "info": "The Shopify variant ID for this tier. Find this in admin under Products → Variant."
        },
        {
          "type": "text",
          "id": "price_cents",
          "label": "Total price (cents)",
          "default": "4900",
          "info": "Price in cents (e.g., 4900 = $49.00)"
        },
        {
          "type": "text",
          "id": "compare_price_cents",
          "label": "Compare-at price (cents)",
          "default": "0",
          "info": "Original price in cents for strike-through. Set 0 to hide."
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "info": "E.g., 'Most Popular', 'Best Value'. Leave blank to hide."
        },
        {
          "type": "checkbox",
          "id": "best_value",
          "label": "Highlight as best value",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quantity Breaks",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "quantity": 1,
            "price_cents": 4900,
            "compare_price_cents": 5900,
            "badge_text": ""
          }
        },
        {
          "type": "tier",
          "settings": {
            "quantity": 3,
            "price_cents": 11700,
            "compare_price_cents": 17700,
            "badge_text": "Most Popular",
            "best_value": true
          }
        },
        {
          "type": "tier",
          "settings": {
            "quantity": 6,
            "price_cents": 17400,
            "compare_price_cents": 35400,
            "badge_text": "Best Value"
          }
        }
      ]
    }
  ]
}
{% endschema %}
