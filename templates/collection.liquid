<section class="cmp-section">
  <div class="cmp-container">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="rte" style="margin-bottom: 24px;">{{ collection.description }}</div>
    {%- endif -%}

    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size == 0 -%}
        <p>No products found.</p>
      {%- else -%}
        <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 24px;">
          {%- for product in collection.products -%}
            <a href="{{ product.url }}" style="text-decoration:none; color:inherit;">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" style="width:100%; aspect-ratio:1; object-fit:cover; border-radius:8px;">
              {%- endif -%}
              <h3 style="font-size:1rem; margin-top:12px;">{{ product.title }}</h3>
              <div style="font-weight:700; color: var(--color-primary);">{{ product.price | money }}</div>
            </a>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav style="margin-top: 32px; text-align:center;">
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
