<section class="cmp-section">
  <div class="cmp-container">
    <h1>Order {{ order.name }}</h1>
    <p style="color: var(--color-text-light);">{{ order.created_at | date: '%B %d, %Y at %I:%M %p' }}</p>
    <p>Status: <strong>{{ order.financial_status }}</strong> · {{ order.fulfillment_status_label }}</p>

    <h2 style="margin-top:32px;">Items</h2>
    <table style="width:100%; border-collapse:collapse;">
      <thead>
        <tr>
          <th style="text-align:left; padding:12px; border-bottom:1px solid var(--color-border);">Product</th>
          <th style="text-align:right; padding:12px; border-bottom:1px solid var(--color-border);">Qty</th>
          <th style="text-align:right; padding:12px; border-bottom:1px solid var(--color-border);">Total</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td style="padding:12px; border-bottom:1px solid var(--color-border);">{{ line_item.title }}</td>
            <td style="padding:12px; text-align:right; border-bottom:1px solid var(--color-border);">{{ line_item.quantity }}</td>
            <td style="padding:12px; text-align:right; border-bottom:1px solid var(--color-border);">{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
    <p style="text-align:right; font-size:1.1rem; margin-top:16px;">Total: <strong>{{ order.total_price | money }}</strong></p>
  </div>
</section>
