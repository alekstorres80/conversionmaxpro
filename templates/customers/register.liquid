<section class="cmp-section">
  <div class="cmp-container" style="max-width: 480px;">
    <h1>Create account</h1>
    {%- form 'create_customer' -%}
      {%- if form.errors -%}<p style="color: var(--color-warning);">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div style="margin-bottom:16px;">
        <label for="first-name">First name</label>
        <input type="text" id="first-name" name="customer[first_name]" style="width:100%; padding:12px; border:1px solid var(--color-border); border-radius:4px;">
      </div>
      <div style="margin-bottom:16px;">
        <label for="last-name">Last name</label>
        <input type="text" id="last-name" name="customer[last_name]" style="width:100%; padding:12px; border:1px solid var(--color-border); border-radius:4px;">
      </div>
      <div style="margin-bottom:16px;">
        <label for="email">Email</label>
        <input type="email" id="email" name="customer[email]" required style="width:100%; padding:12px; border:1px solid var(--color-border); border-radius:4px;">
      </div>
      <div style="margin-bottom:16px;">
        <label for="password">Password</label>
        <input type="password" id="password" name="customer[password]" required style="width:100%; padding:12px; border:1px solid var(--color-border); border-radius:4px;">
      </div>
      <button type="submit" class="cmp-btn cmp-btn--primary cmp-btn--full">Create account</button>
    {%- endform -%}
  </div>
</section>
