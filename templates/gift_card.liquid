<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ 'gift_cards.issued.title' | t: value: gift_card.initial_value | money_without_trailing_zeros, shop: shop.name }}</title>
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main style="max-width: 720px; margin: 64px auto; padding: 0 20px; text-align: center;">
    <h1>{{ shop.name }}</h1>
    <h2 style="margin-top: 24px;">Gift Card</h2>
    <p style="font-size: 2rem; font-weight: 800; color: var(--color-primary, #204A80); margin: 24px 0;">
      {{ gift_card.initial_value | money }}
    </p>
    <p style="font-family: monospace; font-size: 1.25rem; padding: 12px; background: #f5f5f5; border-radius: 6px; margin: 24px auto; max-width: 400px;">
      {{ gift_card.code | format_code }}
    </p>
    {%- if gift_card.enabled == false or gift_card.expired -%}
      <p style="color: #c00;">This gift card is no longer valid.</p>
    {%- elsif gift_card.balance != gift_card.initial_value -%}
      <p>Remaining balance: {{ gift_card.balance | money }}</p>
    {%- endif -%}
  </main>
</body>
</html>
