<div class="cmp-section">
  <div class="cmp-container">
    <h1>Collections</h1>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; margin-top: 32px;">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' -%}
          <a href="{{ collection.url }}" style="border: 1px solid var(--color-border); border-radius: 12px; overflow: hidden; text-decoration: none; color: inherit;">
            {%- if collection.image -%}
              <img src="{{ collection.image | image_url: width: 400 }}" alt="{{ collection.image.alt | escape }}" width="400" style="width: 100%; aspect-ratio: 16/9; object-fit: cover;">
            {%- endif -%}
            <div style="padding: 16px;">
              <div style="font-weight: 600; color: var(--color-heading);">{{ collection.title }}</div>
              <div style="font-size: 0.85rem; color: var(--color-text-light); margin-top: 4px;">{{ collection.products_count }} products</div>
            </div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</div>
