<section class="cmp-section" style="min-height: 70vh; display:flex; align-items:center; justify-content:center; text-align:center;">
  <div class="cmp-container" style="max-width: 600px;">
    {%- if shop.password_message != blank -%}
      <div class="rte" style="margin-bottom: 24px;">{{ shop.password_message }}</div>
    {%- endif -%}

    <h1 style="margin-bottom:16px;">{{ shop.name }}</h1>
    <p style="color: var(--color-text-light); margin-bottom: 24px;">Coming Soon</p>

    {%- form 'storefront_password' -%}
      <div style="display:flex; gap:8px; max-width:400px; margin:0 auto;">
        <input type="password" name="password" placeholder="Enter store password" style="flex:1; padding:12px; border:1px solid var(--color-border); border-radius:4px;">
        <button type="submit" class="cmp-btn cmp-btn--primary">Enter</button>
      </div>
      {%- if form.errors -%}
        <p style="color: var(--color-warning); margin-top:12px;">{{ form.errors.translated_fields.password }} {{ form.errors.messages.password }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
